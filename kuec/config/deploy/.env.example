# Template for /srv/twenty/<env>/.env on the container host. Never commit a filled copy.
# Values marked SECRET come from the secrets manager at deploy time (see 01-deploy.md section 2).

COMPOSE_PROJECT_NAME=twenty-prod
TAG=v2.48.0
HOST_PORT=3000

# Public HTTPS URL. AI attachments, OAuth redirects and app server routes are built from it.
SERVER_URL=https://crm.kuec.example

PG_DATABASE_USER=twenty
PG_DATABASE_NAME=twenty
# SECRET. openssl rand -hex 32 (hex only: it is embedded in PG_DATABASE_URL as is)
PG_DATABASE_PASSWORD=

# SECRET. openssl rand -base64 32. Losing it makes every stored OAuth token and secret unreadable.
ENCRYPTION_KEY=
# Set only during a key rotation, to the previous ENCRYPTION_KEY.
FALLBACK_ENCRYPTION_KEY=

# Guard rails. Admin Panel values override these, so verify-config.sh checks none is overridden.
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true
IS_MULTIWORKSPACE_ENABLED=false
TELEMETRY_ENABLED=false
SIGN_IN_PREFILLED=false
LOGIC_FUNCTION_TYPE=LOCAL
CODE_INTERPRETER_TYPE=DISABLED
# JSON array of private hostnames Twenty may call. Empty means every private address is blocked.
OUTBOUND_HTTP_ALLOWED_INTERNAL_HOSTS=[]
# We install only our own app; the marketplace sync would call registry.npmjs.org hourly.
MARKETPLACE_CATALOG_SYNC_CRON_ENABLED=false

# Object storage. Set here, not in the Admin Panel, so the first boot never writes to container disk.
STORAGE_TYPE=S_3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_NAME=kuec-twenty-prod
STORAGE_S3_ENDPOINT=https://objects.kuec.example
# SECRET
STORAGE_S3_ACCESS_KEY_ID=
# SECRET
STORAGE_S3_SECRET_ACCESS_KEY=

# Only with LOGIC_FUNCTION_TYPE=LAMBDA
# LOGIC_FUNCTION_LAMBDA_REGION=me-central-1
# LOGIC_FUNCTION_LAMBDA_ROLE=arn:aws:iam::<account>:role/twenty-logic-function
# LOGIC_FUNCTION_LAMBDA_ACCESS_KEY_ID=          # SECRET
# LOGIC_FUNCTION_LAMBDA_SECRET_ACCESS_KEY=      # SECRET

# Backups (scripts/backup.sh). Destination is off-host object storage.
BACKUP_LOCAL_DIR=/srv/twenty/backups/prod
BACKUP_S3_ENDPOINT=https://backup.kuec.example
BACKUP_S3_BUCKET=kuec-twenty-backups
BACKUP_S3_REGION=us-east-1
# SECRET
BACKUP_S3_ACCESS_KEY_ID=
# SECRET
BACKUP_S3_SECRET_ACCESS_KEY=
